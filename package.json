{
  "name": "@bedolla/enriweb",
  "version": "0.1.4",
  "description": "MCP server that provides web search and URL fetching via EnriProxy.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "enriweb",
    "enriproxy",
    "web-search",
    "web-fetch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bedolla/EnriWeb.git"
  },
  "bugs": {
    "url": "https://github.com/Bedolla/EnriWeb/issues"
  },
  "homepage": "https://github.com/Bedolla/EnriWeb#readme",
  "license": "AGPL-3.0-only",
  "author": "Pipochas",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "enriweb": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.1"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "engines": {
    "node": ">=24"
  }
}
