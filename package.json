{
  "name": "@bedolla/enriweb",
  "version": "0.1.30",
  "description": "MCP server exposing web search and URL fetching tools backed by EnriProxy.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "enriweb",
    "enriproxy",
    "web-search",
    "web-fetch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bedolla/EnriWeb.git"
  },
  "bugs": {
    "url": "https://github.com/Bedolla/EnriWeb/issues"
  },
  "homepage": "https://github.com/Bedolla/EnriWeb#readme",
  "license": "AGPL-3.0-only",
  "author": "Pipochas",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "enriweb": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "fast-check": "^4.10.3",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
